# Root Docker Compose environment example.
# Copy this file to .env when running docker compose locally.

# MySQL container
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change_me_local_mysql_root_password

# Mongo container
MONGO_DB_NAME=university_exam_system

# Backend auth and encryption secrets
# Generate long random values before any real deployment.
ACCESS_TOKEN_SECRET=change_me_long_random_access_token_secret
REFRESH_TOKEN_SECRET=change_me_long_random_refresh_token_secret
SEB_TOKEN_SECRET=change_me_long_random_seb_token_secret
SEB_SESSION_TRANSFER_SECRET=change_me_long_random_seb_transfer_secret
APP_ENCRYPTION_KEY=change_me_long_random_encryption_secret

# Local URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3500
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3500
VITE_API_PORT=3500

# AI provider defaults
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=transformers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Vector database / embeddings
QDRANT_COLLECTION=materials
EMBEDDING_VECTOR_SIZE=384
