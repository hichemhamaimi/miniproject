# Backend environment example.
# Copy this file to backend/.env for local Node development.

NODE_ENV=development
PORT=3500

# MySQL
DBHOST=localhost
# Use 3307 when connecting from the host to the Docker MySQL service.
# Use 3306 if MySQL is installed directly on your machine.
DBPORT=3307
DBUSER=root
DBPASSWORD=change_me_local_mysql_root_password
DBNAME=university_exam_system
DB_CONNECTION_LIMIT=10

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/university_exam_system
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Auth/session secrets
# Use unique long random strings. Do not reuse these placeholder values.
ACCESS_TOKEN_SECRET=change_me_long_random_access_token_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_SECRET=change_me_long_random_refresh_token_secret
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_TOKEN_COOKIE_NAME=examq_refresh_token

# Safe Exam Browser
SEB_TOKEN_SECRET=change_me_long_random_seb_token_secret
SEB_TOKEN_TTL=12h
SEB_SESSION_TRANSFER_SECRET=change_me_long_random_seb_transfer_secret
SEB_SESSION_TRANSFER_TTL=30m

# Encryption for stored provider API keys
# Keep this stable after first use or previously encrypted provider keys cannot be decrypted.
APP_ENCRYPTION_KEY=change_me_long_random_encryption_secret

# Public URLs / CORS
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3500
CORS_ORIGINS=http://localhost:5173

# Redis / queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant / embeddings
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=materials
QDRANT_RETRY_ATTEMPTS=3
QDRANT_RETRY_DELAY_MS=1000
EMBEDDING_PROVIDER=transformers
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EXTERNAL_EMBEDDING_MODEL=

# LLM provider defaults
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
